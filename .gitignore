# ─── Шаблон GitHub для Godot (из origin/main, сохранён) ───
# Godot 4+ specific ignores
.godot/
.nomedia

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# ─── Форк движка и наша сборка ───
# Сборка Godot
godot/bin/
godot/.sconsign.dblite
godot/platform/android/java/lib/build/
godot/platform/android/java/app/build/
*.os
*.obj
*.o
*.so
*.a
*.pyc
__pycache__/

# Godot-проекты
projects/*/.godot/
projects/*/android/

# Пресеты экспорта КОММИТИМ: в них вся конфигурация сборки под шлем
# (xr_mode, вендор-плагин, arch, gradle_build). Шаблонное правило Godot их
# игнорирует из-за риска пароля release-keystore — у нас его там нет и быть не
# должно: credentials живут в настройках редактора, а не в файле проекта.
# Правила для export_presets.cfg здесь намеренно НЕТ — файл отслеживается.

# Сторонний плагин godot_openxr_vendors — НЕ коммитим.
# 82 МБ бинарников под пять платформ, и правило *.so выше отфильтровало бы 8
# файлов из 36 — в репозиторий попал бы СЛОМАННЫЙ плагин, что хуже отсутствия.
# Устанавливается скриптом: tools/fetch_addons.sh (пин версии там же). ADR-0005.
projects/*/addons/godotopenxrvendors/

# Артефакты
*.apk
*.aab
build/
out/

# Инструменты и локальное
.env
local.properties
tools/local.env

# Редакторы
.vscode/
.idea/
*.swp

# ─── Секреты ───
# OAuth-клиент Google для входа по коду устройства (ADR-0011 п. 5): попадает в APK
# (include_filter пресета), но не в репозиторий.
projects/sphere_menu/secrets/

# Профили из выгрузок сессий: в profile.cfg лежат соль и хеш PIN, а PIN из четырёх цифр по такому
# файлу перебирается офлайн (ADR-0011). Сами секреты (secrets.enc) выгрузка и так не берёт.
docs/measurements/**/profiles/
