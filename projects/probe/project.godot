; Стенд прибора «паспорт железа». Не игра — измеритель.
; Запускается без сцены: скрипт висит автозагрузкой и выходит сам.

config_version=5

[application]
config/name="VRGE Probe"
config/features=PackedStringArray("4.7", "Forward Plus")
run/disable_stdout=false
run/main_scene="res://main.tscn"

[rendering]
renderer/rendering_method="forward_plus"
rendering_device/driver="vulkan"

[xr]
openxr/enabled=true
openxr/startup_alert=false
