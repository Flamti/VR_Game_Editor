; Стенд прибора «паспорт железа». Не игра — измеритель.
; Запускается без сцены: скрипт висит автозагрузкой и выходит сам.

config_version=5

[application]
config/name="VRGE Probe"
config/features=PackedStringArray("4.7", "Forward Plus")
run/disable_stdout=false
run/main_scene="res://main.tscn"

[rendering]
renderer/rendering_method="forward_plus"
; Платформенный оверрайд ОБЯЗАТЕЛЕН: Godot по умолчанию ставит "mobile" для
; мобильных (main.cpp:2492, 2648), а заданный без оверрайда forward_plus
; навязывается и шлему. На Quest это валит создание Vulkan-устройства через
; OpenXR: xrCreateVulkanDeviceKHR отвергает набор запрошенных фич с
; XR_ERROR_VALIDATION_FAILURE, и движок не поднимает DisplayServer вообще.
renderer/rendering_method.mobile="mobile"
rendering_device/driver="vulkan"
; ASTC/ETC2 обязателен для Android-экспорта (export_plugin.cpp:3148)
; и это же целевой формат текстур для Quest.
textures/vram_compression/import_etc2_astc=true

[xr]
openxr/enabled=true
openxr/startup_alert=false
; ОБЯЗАТЕЛЬНО для Android/Quest, и не только для шейдеров.
; Обход issue #115924 (PR #116226) читает эту настройку в
; java_godot_lib_jni.cpp:318 ДО того, как её объявит
; rendering_server.cpp:3813 (GLOBAL_DEF_RST_BASIC, дефолт false).
; Поэтому значение обязано лежать в project.godot: иначе ранний read её не
; видит, обход не срабатывает, и xrCreateVulkanDeviceKHR падает с
; XR_ERROR_VALIDATION_FAILURE — движок вообще не поднимает DisplayServer.
shaders/enabled=true
; Отслеживание рук. Запись в манифест (com.oculus.permission.HAND_TRACKING,
; oculus.software.handtracking) плагин вендора пишет ТОЛЬКО по этой настройке
; (godot_openxr_vendors 5.1.0, meta_export_plugin.cpp:375). Опция пресета
; meta_xr_features/hand_tracking лишь выбирает Optional/Required и без неё
; молча ничего не делает — так простояла с 2026-09-12. Без записи в манифесте
; оболочка считает контроллеры обязательными (RequiresControllersLaunchInterceptor).
; Godot тоже регистрирует обёртку рук только по ней (openxr/register_types.cpp:230).
openxr/extensions/hand_tracking=true
; Свидетели жестов для фазы R (ADR-0008, фаза 0). Профиль XR_EXT_hand_interaction
; даёт щипок и хват действиями карты (Godot регистрирует его только по настройке,
; openxr_hand_interaction_extension.cpp:59). XR_FB_hand_tracking_aim — второй,
; независимый свидетель щипка и единственный — жеста меню левой руки
; (трекер /user/fbhandaim/left, вход menu_pressed).
openxr/extensions/hand_interaction_profile=true
openxr/extensions/meta/hand_tracking_aim=true
; Модель руки от рантайма для визуализации в фазе R (OpenXRFbHandTrackingMesh
; плагина читает эту настройку, openxr_fb_hand_tracking_mesh.cpp:100).
openxr/extensions/meta/hand_tracking_mesh=true
