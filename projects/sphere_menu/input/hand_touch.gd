extends RefCounted

## Касание кончиком пальца поверхности шара, с гистерезисом, и переход касания в протяжку.
##
## Выбор ADR-0008 п. 4: тычок распознаётся КАСАНИЕМ ПО ГЕОМЕТРИИ, а не позой руки — поза тычка по
## суставам в прогоне 13 отделилась один раз из трёх, касание дало ровно 3 из 3.
##
## Числа — из прибора (`projects/probe/probe_hands.gd:113–115`), где тем же гистерезисом ловилось
## касание шарика-цели: вход 0.01 м, выход 0.03 м. Разный вход и выход нужен потому, что палец у
## самой поверхности дрожит: один порог давал бы серию касаний на одном тычке.
##
## Расстояние — СО ЗНАКОМ: минус внутри шара. Сессия 11: по модулю тычок сквозь поверхность на 3 см
## внутрь «отпускал» ячейку, а обратный путь касался её снова — две пары касаний одной ячейки через
## 0.2 с, и второе открыло «Файл 075» на только что перелистнутой странице. Теперь вход и выход —
## только снаружи: уход внутрь касание не рвёт, а палец, оказавшийся внутри, минуя внешнюю сторону (шар
## наехал на руку, трекинг вернулся с кончиком внутри), касания не начинает, пока не выйдет наружу.
##
## Протяжка: касание становится вращением, когда кончик ушёл по поверхности от точки входа дальше
## порога (его задаёт вызывающий — input/hand_source.gd, от размера ячейки). Путь меряется дугой
## от точки входа, а не суммой шагов: дрожь на месте сумму копит, а дугу — нет.

## Ближе этого к поверхности — касание началось, метры.
const TOUCH := 0.01
## Дальше этого от поверхности — касание кончилось, метры.
const RELEASE := 0.03

var inside := false
## Кончик был снаружи оболочки касания — только после этого возможен вход.
var armed := false
## Касание уже стало протяжкой. После "exit" держится до следующего входа — вызывающему
## надо знать, чем кончилось.
var dragging := false
## Направление на точку входа, в координатах шара.
var start_dir := Vector3.ZERO
## Наибольшая дуга от точки входа за касание, метры.
var travel := 0.0
## Фальсификатор «handtouch»: один порог вместо двух — дрожь у поверхности даёт серию касаний.
var falsify_one_threshold := false
## Фальсификатор «handdrag»: порог протяжки 0 — любая дрожь кончика отменяет выбор.
var falsify_no_drag := false
## Фальсификатор «handpoke»: расстояние по модулю, как в сессии 11, — сквозной тычок касается дважды.
var falsify_abs := false


## d — расстояние от поверхности шара со знаком (минус внутри), метры; dir — направление на кончик из центра
## шара в его координатах; radius — радиус шара; drag_m — порог протяжки, метры.
## Возвращает "enter" | "drag" | "exit" | "".
func update(d: float, dir: Vector3, radius: float, drag_m: float) -> String:
	var out := TOUCH if falsify_one_threshold else RELEASE
	if falsify_abs:
		d = absf(d)
		armed = true
	if not inside:
		if d >= TOUCH:
			armed = true
		elif armed:
			armed = false
			inside = true
			dragging = false
			start_dir = dir.normalized()
			travel = 0.0
			return "enter"
		return ""
	if d > out:
		inside = false
		return "exit"
	var arc := start_dir.angle_to(dir.normalized()) * radius
	travel = maxf(travel, arc)
	if not dragging and (arc > drag_m or falsify_no_drag):
		dragging = true
		return "drag"
	return ""


func reset() -> void:
	inside = false
	armed = false
	dragging = false
	travel = 0.0
