extends RefCounted

## Перевал через край — Assisted Mantle (схема владельца, 2026-09-21).
##
## Честная физика на кромке заставляет висеть и дёргаться: последний зацеп кончается ниже края,
## держаться дальше не за что. Поэтому игра распознаёт намерение забраться и **берёт перемещение
## капсулы на себя**.
##
## **Почему переписано.** Первая версия искала площадку одним лучом и требовала, чтобы глаза были
## выше неё на 15 см. На стене высотой 3.4 м с верхним зацепом на 3.2 это значит подтянуться почти
## на полный рост: в сессии 21 владелец до верха так и не перевалился — «забрался наверх при помощи
## телепорта».
##
## Теперь:
##   - кромка размечена в данных уровня (тип `ledge`): зона захвата и **точка приземления**;
##     где разметки нет — остаётся прежний поиск лучом;
##   - намерение = держится за зацеп + глаза выше кромки на HEAD_ABOVE_M (5 см) + либо рывок рукой
##     вниз, либо просто удержание INTENT_HOLD_S;
##   - у РАЗМЕЧЕННОЙ кромки рука, потянутая вниз на PULL_M, запускает перевал при любой высоте глаз
##     (`intent_ledge`, решение владельца 2026-09-26, вариант Б; с 2026-09-27 — расстояние, а не
##     скорость рывка: в сессии 36 медленное подтягивание давало 0.32 м/с при пороге 0.7, и перевала
##     не было). Сессия 35: у верхнего зацепа глаза были 2.3–2.4 при
##     крае 3.60, и правило «глаза над краем» требовало протащить контроллер от поднятой руки ниже
##     груди — на 1.3 м. Отвергнуто: хвататься за сам край (так у shock2quest) — больше правки в
##     лазанье и данных; поднять последний зацеп — лечит одну стену, а не правило;
##   - перенос **строго линейный** в два этапа: сначала вверх («вытащить ноги»), потом вперёд.
##     Ускорение и замедление камеры без участия вестибулярного аппарата вызывают тошноту, поэтому
##     easing здесь запрещён.

## На сколько глаза должны быть выше площадки, чтобы перевал считался намерением, м.
const HEAD_ABOVE_M := 0.05
## Сколько держаться у кромки, если рывка рукой не было, с.
const INTENT_HOLD_S := 0.35
## На сколько потянуть руку вниз (относительно тела) за время хвата у кромки, чтобы начался перевал,
## м. Расстояние, а не скорость: «подтянуться» бывает медленным (сессия 36), а выброс трекинга —
## сантиметр-полтора на один кадр (ловушка 21), до этого порога ему не дотянуться.
const PULL_M := 0.10
## Куда смотреть в поисках площадки, когда кромка не размечена: вперёд от головы по взгляду, м.
const PROBE_AHEAD_M := 0.45
## Пробы лесенкой вперёд, м: первая годная площадка. Дальняя — не дальше вытянутой руки.
const PROBE_STEPS := [0.45, 0.65, 0.85]
## Сколько длится перевал, с. Рекомендованное окно — 0.2…0.4: быстрее дезориентирует, медленнее
## укачивает.
const RISE_S := 0.30
## Какая доля времени уходит на подъём; остальное — вынос вперёд.
const UP_PART := 0.55
## Запас над площадкой, чтобы ноги прошли кромку, м.
const CLEAR_M := 0.02
## Запас, на который человек встаёт от кромки вглубь площадки (только для неразмеченной геометрии).
const INSET_M := 0.35

## Фальсификатор «mantleany»: перевал начинается при любой находке, даже если площадка выше головы
## или наклонная, — человека затаскивает на стены и потолки.
static var falsify_any := false
## Фальсификатор «mantleease»: траектория снова с ускорением (первая версия) — камера разгоняется и
## тормозит, чего в VR делать нельзя.
static var falsify_ease := false
## Фальсификатор «mantleeager»: намерение засчитывается без высоты головы — перевал срабатывает,
## едва коснувшись кромки.
static var falsify_eager := false
## Фальсификатор «pullshort» (tests/smoke_menu.gd): порог — сантиметр, и выброс трекинга запускает
## перевал.
static var falsify_pull_short := false
## Фальсификатор «mantleeyes» (tests/smoke_menu.gd): у размеченной кромки рывку снова нужны глаза
## выше края — вариант Б снят.
static var falsify_ledge_eyes := false


## Годится ли найденная площадка. `head_y` — глаза, `spot_y` — верх площадки, `normal` — её нормаль.
static func fits(head_y: float, spot_y: float, normal: Vector3) -> bool:
	if falsify_any:
		return true
	# Площадка — горизонтальная (по ней можно ходить), и голова уже над ней.
	if normal.angle_to(Vector3.UP) > deg_to_rad(35.0):
		return false
	return head_y - spot_y > HEAD_ABOVE_M


## Порог подтягивания — с учётом фальсификатора.
static func pull_need() -> float:
	return 0.01 if falsify_pull_short else PULL_M


## Намерение забраться: глаза выше кромки И (рука потянута вниз ИЛИ достаточно долгое удержание).
## `pulled_m` — на сколько кисть ушла вниз от своей высшей точки за время у кромки (относительно
## тела), `held_s` — сколько человек уже держится у этой кромки.
static func intent(head_y: float, ledge_y: float, pulled_m: float, held_s: float) -> bool:
	if not falsify_eager and head_y - ledge_y <= HEAD_ABOVE_M:
		return false
	return pulled_m >= pull_need() or held_s >= INTENT_HOLD_S


## Намерение у РАЗМЕЧЕННОЙ кромки: рука потянута вниз — при любой высоте глаз; удержание без
## подтягивания — только если глаза уже над краем (иначе висящий у кромки перевалился бы сам).
## `pulled_m` меряется ОТНОСИТЕЛЬНО ТЕЛА: в мире рука висящего стоит на зацепе.
static func intent_ledge(head_y: float, ledge_y: float, pulled_m: float, held_s: float) -> bool:
	if falsify_ledge_eyes:
		return intent(head_y, ledge_y, pulled_m, held_s)
	if pulled_m >= pull_need():
		return true
	return head_y - ledge_y > HEAD_ABOVE_M and held_s >= INTENT_HOLD_S


## Где человек окажется на неразмеченной геометрии: на площадке, отступив от кромки вглубь.
static func landing(spot: Vector3, look: Vector3) -> Vector3:
	var fwd := look
	fwd.y = 0.0
	if fwd.length() < 0.001:
		return spot
	return spot + fwd.normalized() * INSET_M


## Точка тела в перевале, t от 0 до 1. Два этапа, внутри каждого — РАВНОМЕРНО.
## Сначала подъём (ноги проходят кромку), потом вынос вперёд — так переваливается человек.
static func rise_point(from: Vector3, to: Vector3, t: float) -> Vector3:
	var k := clampf(t, 0.0, 1.0)
	var up: float
	var fwd: float
	if falsify_ease:
		# Первая версия: перекрывающиеся фазы с разгоном — камера ускоряется и тормозит.
		up = clampf(k * 1.6, 0.0, 1.0)
		fwd = clampf((k - 0.25) / 0.75, 0.0, 1.0)
	else:
		up = clampf(k / UP_PART, 0.0, 1.0)
		fwd = clampf((k - UP_PART) / (1.0 - UP_PART), 0.0, 1.0)
	var p := from
	# Подъём — до высоты площадки с запасом, чтобы ноги прошли кромку; на выносе запас снимается.
	var top := to.y + CLEAR_M
	p.y = lerpf(from.y, top, up) if fwd <= 0.0 else lerpf(top, to.y, fwd)
	p.x = lerpf(from.x, to.x, fwd)
	p.z = lerpf(from.z, to.z, fwd)
	return p
