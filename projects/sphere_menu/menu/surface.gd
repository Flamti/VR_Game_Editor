extends RefCounted

## Отображение поверхности — контракт (слой 4, docs/design/sphere-menu.md §4).
##
## Глобус и линза живут за этим контрактом одновременно, пока идёт A/B
## (ADR-0008): меню, ввод и рендер не знают, какая стратегия выбрана.
##
## Все направления — в ЛОКАЛЬНОЙ системе шара, единичные векторы от центра.
## «Перёд» — направление на голову; активная ячейка — та, что под ним.

## Слот ячейки: индекс пункта папки ≥ 0, служебная «назад» или пустая.
const SLOT_BACK := -1
const SLOT_EMPTY := -2

## Направление на голову, локально. Меню обновляет каждый кадр.
var front := Vector3(0, 0, 1)
## Верх шара для базиса линзы, локально.
var up := Vector3(0, 1, 0)
## Растёт при любом изменении того, что возвращает visible_cells(): рендер не
## пересчитывает ячейки, пока версия та же (самопроверка 2026-09-15: покадровый
## пересчёт в GDScript стоил 6.6–7.8 мс из 11.11).
var version := 0


## Раздать n пунктов по ячейкам от текущей активной. Вызывается при открытии папки.
func assign(_item_count: int) -> void:
	pass


## Видимые ячейки: Array словарей
##   key      — устойчивый ключ ячейки (int у глобуса, Vector2i у линзы)
##   slot     — индекс пункта | SLOT_BACK | SLOT_EMPTY
##   dir      — направление центра ячейки, единичное, локально
##   sides    — 5 или 6
##   scale    — множитель размера (линза сжимает к задней стороне), 0…1
##   spin     — поворот ячейки вокруг нормали, рад (выравнивание контура)
func visible_cells() -> Array:
	return []


## Ключ ячейки под направлением.
func cell_at_direction(_dir: Vector3) -> Variant:
	return null


## Направление центра ячейки по ключу; Vector3.ZERO — ячейки нет.
func direction_of(_key: Variant) -> Vector3:
	return Vector3.ZERO


## Слот ячейки по ключу.
func slot_of(_key: Variant) -> int:
	return SLOT_EMPTY


## Повернуть шар (локально). Глобус поворачивает ячейки, линза сдвигает содержимое.
func apply_rotation(_q: Quaternion) -> void:
	pass


## Остаток до детента: угол (рад) от центра активной ячейки до «переда».
## Меню гасит его пружиной через apply_rotation.
func snap_error() -> float:
	return 0.0


## Поворот, который ставит центр активной ячейки на «перёд».
func snap_rotation() -> Quaternion:
	return Quaternion.IDENTITY


## Угловой радиус ячейки, рад — для гистерезиса и шага вращения.
func cell_angle() -> float:
	return 0.1


## Для рендера: ячейки в системе, где их можно рисовать, и поворот всего узла.
## По умолчанию — visible_cells() без поворота. Глобус переопределяет: его ячейки
## неподвижны относительно шара, и вращение — это поворот узла MultiMesh, а не
## пересчёт 252 ячеек (самопроверка 2026-09-15: скрипты 8.8 мс при вращении).
func render_cells() -> Array:
	return visible_cells()


func render_basis() -> Basis:
	return Basis.IDENTITY


## Версия того, что возвращает render_cells(): у глобуса поворот её не меняет.
func render_version() -> int:
	return version


## Прокрутка — непрозрачное значение для памяти папки (state.gd).
func get_scroll() -> Variant:
	return null


func set_scroll(_v: Variant) -> void:
	pass
