extends RefCounted

## Подсказка по управлению. Зависит от источника ввода И от того, открыт ли шар.
##
## Сессия 16 (2026-09-20): подсказка говорила только про меню, шар простоял открытым все 408 секунд,
## и перемещение — которое при открытом шаре намеренно заперто (ADR-0013 п. 6: стики принадлежат
## меню) — не испытали ни разу. Человек в шлеме перебрал все его настройки и не узнал, что для
## ходьбы шар надо закрыть. Поэтому при открытом шаре подсказка кончается строкой «закрыть и идти»,
## а при закрытом — рассказывает про перемещение, с текущими настройками по именам.
##
## Текст статический и чистый: его проверяют настольно, без шлема.

## Фальсификатор «crouchquiet»: про присед в подсказке не сказано — кнопку не находят (сессия 21:
## «присед не делал, не заметил его»).
static var falsify_no_crouch := false
## Фальсификатор «helpstale»: подсказка не зависит от состояния шара — возвращается поведение
## сессии 16, когда про перемещение не было сказано нигде.
static var falsify_stale := false

## Способ перемещения → как это назвать человеку. Ключи — значения настройки move_mode.
const MOVE_NAMES := {
	"blink": "телепорт с миганием",
	"shift": "телепорт рывком",
	"head": "идти по взгляду",
	"hand": "идти по руке",
}


static func move_line(move_mode: String) -> String:
	var name: String = MOVE_NAMES.get(move_mode, move_mode)
	if move_mode in ["head", "hand"]:
		return "левый стик — %s" % name
	return "левый стик вперёд и отпустить — %s" % name


static func turn_line(turn_mode: String, snap_angle: float, turn_speed: float) -> String:
	if turn_mode == "snap":
		return "правый стик — поворот щелчком %.0f°" % snap_angle
	return "правый стик — плавный поворот %.0f°/с" % turn_speed


## Управление меню: первые строки подсказки, они же были всей подсказкой до сессии 16.
static func menu_lines(hands: bool) -> String:
	if hands:
		return "руки: кулак левой — шар · коснуться ячейки кончиком правого — открыть · удержать касание — действия\nпровести пальцем по шару — вращать · щипок правой — нажать на панели лучом ладони · встряхнуть — верхний уровень\nвзять контроллер — управление вернётся к контроллерам"
	return "Y — шар · курок — открыть · удержание — действия · X — назад · встряхнуть — верхний уровень · оба стика — скриншот\nправый: луч или касание + курок · касание + грип — вращать · B — отменить · стик — прокрутка панели\nнастройки — лучом по панели: ползунок, кнопки, цифры"


## Полная подсказка. hands — ведут руки; menu_open — шар открыт.
static func text(hands: bool, menu_open: bool, move_mode: String, turn_mode: String,
		snap_angle: float, turn_speed: float) -> String:
	if falsify_stale:
		return menu_lines(hands)
	if menu_open:
		var close: String = "кулак левой" if hands else "Y"
		return "%s\n%s — закрыть шар, чтобы идти" % [menu_lines(hands), close]
	if hands:
		# Руками при закрытом шаре: телепорт щипком и тяга мира; стиков у рук нет.
		return "шар закрыт — перемещение:\nщипок правой и отпустить — %s · щипок обеими — тянуть мир · хват у зацепа — лезть\nкулак левой — открыть шар" % MOVE_NAMES.get(move_mode, move_mode)
	var crouch: String = "" if falsify_no_crouch else " · A — присесть"
	return "шар закрыт — перемещение:\n%s · %s\nгрип у зацепа — лезть%s · Y — открыть шар" % [
			move_line(move_mode), turn_line(turn_mode, snap_angle, turn_speed), crouch]
