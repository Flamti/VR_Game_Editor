shader_type spatial;
// Сетка пола шар-меню (этап Ф3): линии в МИРОВЫХ координатах, поэтому при ходьбе сетка стоит на
// месте, а плоскость под ней просто едет за человеком. Прозрачность к краю радиуса гаснет —
// иначе у квада был бы видимый край.
//
// unshaded: свет на линии не влияет, цвет задан настройкой. depth_draw_never — квад не должен
// закрывать собой мир. «Рентген» (сетка поверх объектов) — отдельный шейдер floor_grid_xray.gdshader:
// режим проверки глубины задаётся в коде и в рантайме не меняется.
render_mode unshaded, blend_mix, depth_draw_never, cull_disabled;

#include "res://world/floor_grid_body.gdshaderinc"
