extends RefCounted

## Разворот табличек лицом к человеку (сессия 18).
##
## Билборд Godot (`BILLBOARD_FIXED_Y`) держит надпись параллельно **плоскости экрана**, то есть
## поворачивает её вместе с поворотом шлема: табличка сбоку от взгляда оказывается повёрнутой не к
## человеку, а «как экран». Владелец после сессии 18: «вращаются в соответствии с вращением шлема,
## а должны всегда смотреть лицевой стороной к шлему».
##
## Отсюда — свой разворот: каждая табличка смотрит на ТОЧКУ, где сейчас голова, а не на плоскость
## взгляда. Вертикаль при этом не заваливается: наклон головы на надпись не переносится.
##
## Место таблички остаётся фиксированным — поворачивается только лицевая сторона.

## Фальсификатор «signbillboard»: возвращается билборд Godot — таблички снова следуют за поворотом
## шлема, а не смотрят на него.
static var falsify_billboard := false
## Фальсификатор «signevery»: разворот считается каждый кадр, как до сессии 24 — восемь записей
## `global_basis` за кадр, и каждая тянет пересчёт по дереву.
static var falsify_every_frame := false

## Насколько должна сдвинуться голова, чтобы разворот пересчитывался, м. Меньше — незаметно глазу:
## на двух метрах 3 см дают около 0.9°.
const HEAD_EPS := 0.03

## Где была голова, когда таблички разворачивали в прошлый раз.
static var _head_was := Vector3(9e9, 9e9, 9e9)
## Фальсификатор «signscan»: `due` всегда «да» — вызывающий обходит группу табличек каждый кадр.
static var falsify_scan := false


## Пора ли разворачивать. Отдельно от `face_all`, чтобы вызывающий спрашивал порог ДО того, как
## соберёт группу: `get_nodes_in_group` строит новый массив каждый кадр, и раньше это делалось,
## даже когда `face_all` тут же выходила по порогу (аудит 2026-09-23).
static func due(head: Vector3) -> bool:
	return falsify_scan or falsify_every_frame or head.distance_to(_head_was) >= HEAD_EPS


## Забыть прошлое положение головы: таблички появились или исчезли — развернуть заново.
static func forget() -> void:
	_head_was = Vector3(9e9, 9e9, 9e9)


## Поворот таблички, стоящей в `at`, лицом к голове в `head`. Вертикаль мира сохраняется.
## Лицевая сторона Label3D — это +Z узла, поэтому смотрим «затылком» по направлению от головы.
static func basis_towards(at: Vector3, head: Vector3) -> Basis:
	var to_head := head - at
	to_head.y = 0.0
	if to_head.length() < 0.001:
		# Голова ровно над табличкой: поворачивать не к чему, оставляем как есть.
		return Basis()
	var z := to_head.normalized()
	var x := Vector3.UP.cross(z).normalized()
	return Basis(x, Vector3.UP, z)


## Развернуть все таблички. Узлы — из группы «sign»; те, что уже не в дереве, пропускаются.
##
## Пересчёт — только когда голова СДВИНУЛАСЬ: запись `global_basis` тянет за собой пересчёт
## трансформов по дереву, а табличек восемь, и раньше это делалось каждый кадр (сессия 24: CPU+
## скрипты 6.40 мс против 2.92). Поворот головы на месте разворота не меняет: табличка смотрит в
## ТОЧКУ, где голова, а не вдоль взгляда.
static func face_all(signs: Array, head: Vector3) -> int:
	if falsify_billboard:
		return 0
	if not falsify_every_frame and head.distance_to(_head_was) < HEAD_EPS:
		return 0
	_head_was = head
	var n := 0
	for s in signs:
		var node := s as Node3D
		if node == null or not is_instance_valid(node):
			continue
		node.global_basis = basis_towards(node.global_position, head)
		n += 1
	return n
